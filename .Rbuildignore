# RStudio / IDE files
^.*\.Rproj$
^\.Rproj\.user$
^\.vscode$

# Local/user config
^\.Rprofile$
^\.Renviron$
^\.env$
^\.lintr$

# Version control / GitHub
^\.git$
^\.gitignore$
^\.github$

# CI / deployment / containers
^Dockerfile$
^\.dockerignore$
^Jenkinsfile$
^deploy\.sh$

# pkgdown site and config
^_pkgdown\.yml$
^docs$
^pkgdown$

# Local dependency/vendor libraries
^lib$
^libWin$
^libMac$
^libLinux$
^deps$

# Build/test artifacts
^covr$
^bin$
^src/.+\.so$
^src/.+\.o$
^src/.+\.dll$
^src/.+\.dylib$
^.*\.tar\.gz$
^.*\.Rcheck$

# Non-package license/readme variants
^LICENSE\.md$

^inst/data$
^createMakeVars
