# Fallback Makevars for local builds. Source installs regenerate this file via configure.

STANHEADERS_SRC = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'cat(system.file("include", "src", package = "StanHeaders", mustWork = TRUE))')
STANC_FLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'if (utils::packageVersion("rstan") > "2.26") cat("-DUSE_STANC3")')
PKG_CPPFLAGS = -I"../inst/include" -I"$(STANHEADERS_SRC)" -DBOOST_DISABLE_ASSERTS -DEIGEN_NO_DEBUG -DBOOST_MATH_OVERFLOW_ERROR_POLICY=errno_on_error $(STANC_FLAGS)
PKG_CXXFLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'cat(RcppParallel::CxxFlags())') $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'cat(StanHeaders:::CxxFlags())')
PKG_LIBS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'cat(RcppParallel::RcppParallelLibs())') $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e 'cat(StanHeaders:::LdFlags())')
CXX_STD = CXX17
